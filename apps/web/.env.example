# Supabase — copie para apps/web/.env.local e preencha.
# Painel do Supabase → Project Settings → API.
# Use APENAS a chave publishable (pública). NUNCA coloque a service_role/secret no front.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos da competição (Web Push): chave PÚBLICA VAPID (a privada fica só nos secrets da Edge Function).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
